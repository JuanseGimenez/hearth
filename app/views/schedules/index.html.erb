<h1>Schedules</h1>

<% if @schedules.empty? %>
  <p class="muted">No schedules yet. Add one below.</p>
<% else %>
  <ul class="list">
    <% @schedules.each do |s| %>
      <li>
        <span class="when"><%= format("%02d:%02d", s.hour, s.minute) %></span>
        <span><strong><%= s.device.name %></strong> · <%= s.action %></span>
        <% if s.days_of_week.present? %><span class="badge">days: <%= s.days_of_week %></span><% end %>
        <span class="badge <%= "on" if s.enabled %>"><%= s.enabled ? "enabled" : "disabled" %></span>
        <span class="spacer"></span>
        <%= button_to (s.enabled ? "Disable" : "Enable"), schedule_path(s), method: :patch, class: "ghost small" %>
        <%= button_to "Delete", schedule_path(s), method: :delete, class: "danger small" %>
      </li>
    <% end %>
  </ul>
<% end %>

<div class="card">
  <h2>New schedule</h2>
  <%= render "form" %>
</div>
