<%= form_with model: @schedule, url: schedules_path do |f| %>
  <%= f.collection_select :device_id, @devices, :id, :name %>
  <%= f.select :action, Schedule::ACTIONS %>
  <%= f.number_field :hour, in: 0..23, placeholder: "hour" %>
  <%= f.number_field :minute, in: 0..59, placeholder: "min" %>
  <%= f.text_field :days_of_week, placeholder: "e.g. 1,2,3,4,5 (blank = every day)" %>
  <%= f.check_box :enabled, checked: true %> enabled
  <%= f.submit "Add" %>
<% end %>
