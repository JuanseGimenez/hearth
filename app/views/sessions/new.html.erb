<div class="auth">
  <div class="card">
    <h1>🔶 Smart Home</h1>
    <p class="muted">Enter your password to continue</p>
    <%= form_with url: login_path, method: :post do |f| %>
      <%= f.password_field :password, placeholder: "Password", autofocus: true %>
      <%= f.submit "Enter", class: "primary" %>
    <% end %>
  </div>
</div>
