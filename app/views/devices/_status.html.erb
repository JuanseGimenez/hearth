<%= turbo_frame_tag dom_id(device, :status), class: "ml-auto" do %>
  <% state = device_power_state(device, result) %>
  <% text = { on: "text-green-600", unreachable: "text-red-600" }[state] || "text-slate-500 dark:text-slate-400" %>
  <% dot = { on: "bg-green-600 ring-2 ring-green-600/25", unreachable: "bg-red-600" }[state] || "bg-slate-400" %>
  <span class="inline-flex items-center gap-1.5 text-xs font-semibold <%= text %>" data-state="<%= state %>">
    <span class="w-2.5 h-2.5 rounded-full <%= dot %>"></span><%= device_power_label(state) %>
  </span>
  <%= link_to "↻", device_status_path(device), class: "ml-0.5 text-slate-500 dark:text-slate-400 hover:text-amber-600 text-sm no-underline", title: "Refresh" %>
<% end %>
