<div class="bg-white dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700 rounded-2xl p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
  <div class="flex items-center gap-2">
    <span class="text-xl leading-none"><%= device_icon(device) %></span>
    <h3 class="flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[1.05rem] font-semibold m-0"><%= device.name %></h3>
    <%= turbo_frame_tag dom_id(device, :status), src: device_status_path(device), loading: :lazy, class: "ml-auto" do %>
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500"><span class="w-2.5 h-2.5 rounded-full bg-slate-400 animate-pulse"></span>…</span>
    <% end %>
  </div>
  <div class="text-slate-500 dark:text-slate-400 text-xs my-2">
    <%= device.category %><%= " · #{device.ip}" if device.ip.present? %><%= " · v#{device.protocol_version}" if device.protocol_version.present? %>
    · <%= link_to "Edit", edit_device_path(device), class: "text-amber-600 hover:underline" %>
  </div>

  <div class="flex flex-col gap-3">
    <div class="inline-flex gap-2">
      <%= button_to "On",  device_commands_path(device), params: { action_name: "turn_on" }, class: btn(:primary) %>
      <%= button_to "Off", device_commands_path(device), params: { action_name: "turn_off" }, class: btn(:ghost) %>
    </div>

    <% if device.supports?(:brightness) %>
      <%= form_with url: device_commands_path(device), method: :post, class: "flex gap-2 items-center" do |f| %>
        <%= f.hidden_field :action_name, value: "set_brightness" %>
        <%= f.range_field :percent, in: 0..100, value: 100, class: "flex-1" %>
        <%= f.submit "Set", class: btn(:primary) %>
      <% end %>
    <% end %>

    <% if device.supports?(:color) %>
      <%= form_with url: device_commands_path(device), method: :post, class: "flex gap-2 items-center" do |f| %>
        <%= f.hidden_field :action_name, value: "set_color" %>
        <%= f.color_field :hex, value: "#ffffff", id: dom_id(device, :color), class: color_input_class %>
        <%= f.hidden_field :r %><%= f.hidden_field :g %><%= f.hidden_field :b %>
        <%= f.submit "Set color", class: btn(:primary), onclick: "var h=this.form.hex.value;this.form.r.value=parseInt(h.substr(1,2),16);this.form.g.value=parseInt(h.substr(3,2),16);this.form.b.value=parseInt(h.substr(5,2),16);" %>
      <% end %>
    <% end %>
  </div>
</div>
