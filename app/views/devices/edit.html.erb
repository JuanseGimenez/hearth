<h1>Edit <%= @device.name %></h1>

<% if @device.errors.any? %>
  <div class="flash alert">
    <ul><% @device.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
  </div>
<% end %>

<div class="card">
  <%= form_with model: @device, class: "stack" do |f| %>
    <div class="field"><%= f.label :name %><%= f.text_field :name %></div>
    <div class="field"><%= f.label :category %><%= f.select :category, Device::CATEGORIES %></div>
    <div class="field"><%= f.label :ip, "IP" %><%= f.text_field :ip %></div>
    <div class="field"><%= f.label :protocol_version, "Protocol version" %><%= f.text_field :protocol_version %></div>
    <div class="field">
      <label>Capabilities</label>
      <div class="checks">
        <label><%= f.check_box :on_off %> On/Off</label>
        <label><%= f.check_box :brightness %> Brightness</label>
        <label><%= f.check_box :color %> Color</label>
      </div>
    </div>
    <%= f.submit "Save", class: "primary" %>
  <% end %>
</div>

<div class="card">
  <h2>Tools</h2>
  <div class="row">
    <%= button_to "Auto-detect protocol version", device_version_detection_path(@device) %>
    <%= button_to "Delete device", device_path(@device), method: :delete, class: "danger",
          data: { turbo_confirm: "Delete #{@device.name}? This cannot be undone." } %>
  </div>
</div>
